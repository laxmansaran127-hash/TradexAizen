# Copy to .env.local for local development. Never commit real credentials.
# IMPORTANT: VITE_* values are compiled into browser JavaScript and are public.
# Do not put paid provider API secrets in any VITE_* variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Provider API keys currently used by the client-side implementation are NOT
# safe for a public deployment. Keep these unset in public builds until you
# implement a server-side proxy/Edge Function and update the client to call it.
# VITE_FINNHUB_API_KEY=
# VITE_TWELVEDATA_API_KEY=
# VITE_NEWS_API_KEY=

# Optional calendar proxy URL (must be a public endpoint with appropriate CORS).
VITE_CALENDAR_URL=
